<view class="container">
  <view class="header">
    <text class="title">{{title}}</text>
    <text class="subtitle">主程序版本: {{mainVersion}}</text>
    <text class="subtitle">登录状态: {{isLogin ? '已登录' : '未登录'}}</text>
  </view>

  <view class="card">
    <text class="card-title">功能列表</text>
    <view class="feature-list">
      <view 
        wx:for="{{features}}" 
        wx:key="index" 
        class="feature-item {{currentFeature === item ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="selectFeature"
      >
        <text class="feature-name">{{item.name}}</text>
        <text class="feature-desc">{{item.description}}</text>
      </view>
    </view>
    
    <view wx:if="{{currentFeature}}" class="selected-feature">
      <text>当前选择: {{currentFeature.name}}</text>
      <text>{{currentFeature.description}}</text>
    </view>
  </view>

  <view class="card">
    <text class="card-title">计数器示例</text>
    <view class="counter-section">
      <button class="counter-btn" bindtap="decrementCounter">-</button>
      <text class="counter-value">{{counter}}</text>
      <button class="counter-btn" bindtap="incrementCounter">+</button>
    </view>
  </view>

  <sub-custom counter="{{counter}}"></sub-custom>

  <view class="action-buttons">
    <button class="btn-primary" bindtap="callMainLogin">调用主程序登录</button>
    <button class="btn-secondary" bindtap="backToMain">返回主程序</button>
  </view>
</view>