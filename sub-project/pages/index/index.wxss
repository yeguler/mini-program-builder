.container {
  padding: 30rpx;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #007AFF;
  margin-bottom: 20rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.feature-list {
  margin-bottom: 20rpx;
}

.feature-item {
  padding: 20rpx;
  border: 2rpx solid #f0f0f0;
  border-radius: 8rpx;
  margin-bottom: 15rpx;
  transition: all 0.3s;
}

.feature-item.active {
  border-color: #007AFF;
  background-color: #f0f8ff;
}

.feature-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.feature-desc {
  display: block;
  font-size: 24rpx;
  color: #666;
}

.selected-feature {
  background: #f8f9fa;
  padding: 20rpx;
  border-radius: 8rpx;
  border-left: 4rpx solid #007AFF;
}

.selected-feature text {
  display: block;
  font-size: 26rpx;
  margin-bottom: 5rpx;
}

.counter-section {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
}

.counter-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #007AFF;
  min-width: 100rpx;
  text-align: center;
}

.counter-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #007AFF;
  color: white;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-primary {
  background: #007AFF;
  color: white;
  border-radius: 8rpx;
  padding: 25rpx;
  text-align: center;
}

.btn-secondary {
  background: #f0f0f0;
  color: #333;
  border-radius: 8rpx;
  padding: 25rpx;
  text-align: center;
}