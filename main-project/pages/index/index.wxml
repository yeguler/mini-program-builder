<common-header title="{{title}}"></common-header>

<view class="container">
  <view class="card">
    <view class="text-center mb-20">
      <text class="text-lg">欢迎使用主程序模板</text>
    </view>
    
    <view class="info-section mb-20">
      <text class="text">版本: {{version}}</text>
    </view>
    
    <view class="info-section mb-20">
      <text class="text">登录状态: {{isLogin ? '已登录' : '未登录'}}</text>
    </view>
    
    <view class="info-section mb-20">
      <text class="text">当前时间: {{currentTime}}</text>
    </view>
  </view>

  <view class="card">
    <button class="btn-primary mb-20" bindtap="onLoginTap">
      {{isLogin ? '退出登录' : '点击登录'}}
    </button>
    
    <button class="btn-secondary mb-20" open-type="getUserInfo" bindgetuserinfo="onGetUserInfo">
      获取用户信息
    </button>
    
    <button class="btn-secondary mb-20" bindtap="showVersionInfo">
      版本信息
    </button>
    
    <button class="btn-secondary" bindtap="gotoSubPackage">
      跳转到分包页面
    </button>
  </view>

  <view class="card" wx:if="{{userInfo}}">
    <view class="user-info">
      <image class="avatar" src="{{userInfo.avatarUrl}}"></image>
      <view class="user-detail">
        <text class="username">{{userInfo.nickName}}</text>
        <text class="user-gender">{{userInfo.gender === 1 ? '男' : userInfo.gender === 2 ? '女' : '未知'}}</text>
      </view>
    </view>
  </view>
</view>