<view class="container">
  <view class="header">
    <text class="title">{{title}}</text>
  </view>

  <view class="card">
    <text class="card-title">系统信息</text>
    <view class="info-item">
      <text class="label">版本号:</text>
      <text class="value">{{version}}</text>
    </view>
    <view class="info-item">
      <text class="label">描述:</text>
      <text class="value">{{description}}</text>
    </view>
  </view>

  <view class="card">
    <text class="card-title">操作</text>
    <button class="btn-primary mb-20" bindtap="checkUpdate">检查版本</button>
    <button class="btn-secondary" bindtap="contactUs">联系我们</button>
  </view>

  <view class="card">
    <text class="card-title">主程序功能</text>
    <text class="feature-item">• 提供公共组件和工具函数</text>
    <text class="feature-item">• 统一登录和用户管理</text>
    <text class="feature-item">• 支持多个子程序集成</text>
    <text class="feature-item">• 统一的样式和交互规范</text>
  </view>
</view>